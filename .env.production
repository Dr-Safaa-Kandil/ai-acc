# ==========================================
# 1. إعدادات الاتصال بقاعدة بيانات Supabase (محلي / تطوير)
# ==========================================
VITE_SUPABASE_URL=https://your-local-or-dev-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# ==========================================
# 2. إعدادات الـ Backend المحلي ونقاط الربط (API)
# ==========================================
VITE_API_BASE_URL=http://localhost:3001/api
VITE_APP_ENV=development

# ==========================================
# 3. مفاتيح الذكاء الاصطناعي ومعالجة الوثائق (OCR & LLM)
# ==========================================
# مفتاح محلي لتشغيل نماذج الاستخلاص الذكي للفواتير ومستندات COD
VITE_PADDLE_OCR_ENDPOINT=http://localhost:8000/ocr
VITE_AI_AGENT_TIMEOUT=30000